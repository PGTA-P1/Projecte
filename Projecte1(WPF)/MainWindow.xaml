<Window x:Class="Projecte1_WPF_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        xmlns:local="clr-namespace:Projecte1_WPF_"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <local:SceneViewModel x:Key="SceneViewModel" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0" Padding="0" FontSize="11">
            <Label Padding="4,2" VerticalAlignment="Center">Projecte P1</Label>
            <Separator/>
            <Menu Background="Transparent" VerticalAlignment="Center">
                <MenuItem Header="Load Configuration" Padding="4,2">
                    <MenuItem Header="Default Airspace"/>
                    <Separator Opacity="0.4" Margin="0,1"/>
                    <MenuItem Header="Load Airspace"/>
                    <Separator Opacity="0.4" Margin="0,1"/>
                    <MenuItem Header="Load Trajectories"/>
                </MenuItem>
            </Menu>
        </ToolBar>
        <esri:SceneView Grid.Row="1"
                IsAttributionTextVisible="False"
                Scene="{Binding Scene, Source={StaticResource SceneViewModel}}" />
    </Grid>
</Window>

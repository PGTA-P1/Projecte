<UserControl x:Class="Projecte1_WPF_.ComparePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="340">
    <!-- COMPARISON of the sectors ticked in the list (two or more): one block per sector, stacked, with a reduced set of
         the sector panel's figures. Filled by MainWindow (SetSectors when the ticks or the analysis change, SetNow at every
         timeline update) -->
    <Border BorderBrush="#FFD5DFE5" BorderThickness="1,0,0,0">
        <DockPanel ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="20000">
            <Grid DockPanel.Dock="Top" Background="#FFEEF5FD">
                <StackPanel Margin="12,8,44,8">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" Foreground="#FF5A6773" TextWrapping="Wrap"
                               Text="Click a name for its full panel. × or its tick in the list drops it." />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Width="28" Height="28"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click" ToolTip="Untick every sector and show them all again (Esc)" AutomationProperties.Name="Close the comparison" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="List" Margin="12,2,12,12" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

<UserControl x:Class="Projecte1_WPF_.ComparePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="340">
    <UserControl.Resources>
        <!-- The sector panel's switch: blue track and knob on the right = on -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF3C474D" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="28" Height="16" CornerRadius="8" Background="#FFD5DBD8" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF1F6E6B" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF0E3B39" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- COMPARISON of the sectors ticked in the list (two or more): one block per sector, stacked, with a reduced set of
         the sector panel's figures. Filled by MainWindow (SetSectors when the ticks or the analysis change, SetNow at every
         timeline update) -->
    <Border BorderBrush="#FFE1E5E3" BorderThickness="1,0,0,0">
        <DockPanel ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="20000">
            <Grid DockPanel.Dock="Top" Background="#FFF7F8F7">
                <StackPanel Margin="12,8,76,8">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                               ToolTip="Click a sector's name for its full panel; × next to it, or its tick in the list, drops it from the comparison." />
                    <!-- Same switch as the sector panel: the time bar marks when all of them are open; playback can stop
                         when that ends (one of them closes) -->
                    <ToggleButton x:Name="PauseToggle" Style="{StaticResource Switch}" IsChecked="True" Margin="0,7,0,0"
                                  AutomationProperties.Name="Pause playback when one of them closes"
                                  ToolTip="The green marks under the time bar are the periods when all these sectors are open at once. On: playback stops when one of them closes, so you see it happen; press Play to go on. Off: playback goes on. Either way a short notice appears."
                                  Content="Pause playback when one of them closes" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,40,0" Width="28" Height="28"
                        Content="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Export_Click" AutomationProperties.Name="Export the comparison"
                        ToolTip="Export the comparison: comparison_load_(sectors).csv (the load of every compared sector side by side at each sliding step) and comparison_summary_(sectors).csv (one row per sector), named after the compared sectors, in the Exports folder" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Width="28" Height="28"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click" ToolTip="Untick every sector and show them all again (Esc)" AutomationProperties.Name="Close the comparison" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="List" Margin="12,2,12,12" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

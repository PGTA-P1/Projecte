<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
	<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Projecte1_WPF_</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The app's logo (one sector, the route entering it, the aircraft inside): icon of the .exe and so of its shortcuts -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Esri.ArcGISRuntime" Version="300.1.0" />
    <PackageReference Include="Esri.ArcGISRuntime.runtimes.win" Version="300.1.0" />
    <PackageReference Include="Esri.ArcGISRuntime.WPF">
      <Version>300.1.0</Version>
    </PackageReference>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>
    <ItemGroup>
	    <None Update="Archives\**">
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </None>
	    <!-- ArcGIS licence and API key next to the program (ArcGisKeys): scrambled (committed) and, if present, the
	         readable local override (git-ignored; the installer leaves it out) -->
	    <None Update="arcgis.keys.dat">
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </None>
	    <None Update="arcgis.keys.json">
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </None>
    </ItemGroup>
    <!-- Archivo (SIL Open Font License, Fonts\OFL.txt): the UI font, embedded so it does not need installing -->
    <ItemGroup>
	    <Resource Include="Fonts\*.ttf" />
	    <None Include="Fonts\OFL.txt" />
    </ItemGroup>
    <!-- Window icon (taskbar, Alt+Tab) and the title bar image -->
    <ItemGroup>
	    <Resource Include="Assets\app.ico" />
	    <Resource Include="Assets\logo-256.png" />
    </ItemGroup>

</Project>
